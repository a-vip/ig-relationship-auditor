{
  "manifest_version": 3,
  "name": "IG Relationship Auditor Bridge",
  "version": "1.0.0",
  "description": "Connects your GitHub Pages IG Relationship Auditor dashboard to your logged-in Instagram browser session for automated live fact-checking and paced unfollowing.",
  "permissions": [
    "cookies",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Relationship Auditor Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a-vip.github.io/ig-relationship-auditor/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": ["ig-content.js"],
      "run_at": "document_idle"
    }
  ]
}
