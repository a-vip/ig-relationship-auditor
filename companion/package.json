{
  "name": "ig-relationship-auditor-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Playwright Companion Bridge & CLI for IG Relationship Auditor (live fact-checking, persistent session, and paced unfollow automation).",
  "bin": {
    "ig-auditor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "serve": "tsx src/cli.ts serve",
    "login": "tsx src/cli.ts login",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
