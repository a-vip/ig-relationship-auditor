{
  "name": "ig-relationship-auditor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first Instagram Relationship Auditor, Live Fact-Checker & Safe Unfollow Studio for GitHub Pages, with bundled MV3 Extension and Playwright Companion.",
  "author": "Avi Perera <aviperera0@gmail.com>",
  "license": "MIT",
  "homepage": "https://a-vip.github.io/ig-relationship-auditor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-vip/ig-relationship-auditor.git"
  },
  "scripts": {
    "dev": "node scripts/bundle-extension.mjs && vite",
    "build": "node scripts/bundle-extension.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bundle:extension": "node scripts/bundle-extension.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
